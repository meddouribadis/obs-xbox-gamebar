<Application
    x:Class="ObsGameBarWidget.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:ObsGameBarWidget.Converters"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <converters:SceneBackgroundConverter x:Key="SceneBackgroundConverter"/>
            <converters:SceneFontWeightConverter x:Key="SceneFontWeightConverter"/>
            <converters:MuteBackgroundConverter x:Key="MuteBackgroundConverter"/>
            <converters:MuteIconConverter x:Key="MuteIconConverter"/>
            <converters:MuteTextConverter x:Key="MuteTextConverter"/>

            <!-- Styles & Couleurs thème Xbox Game Bar sombre -->
            <SolidColorBrush x:Key="GameBarBackgroundBrush" Color="#1E1E1E" Opacity="0.92"/>
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#2A2A2A"/>
            <SolidColorBrush x:Key="AccentBrush" Color="#0078D7"/>
            <SolidColorBrush x:Key="RecordActiveBrush" Color="#D13438"/>
            <SolidColorBrush x:Key="StreamActiveBrush" Color="#107C41"/>
            <SolidColorBrush x:Key="WarningBrush" Color="#FFB900"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
