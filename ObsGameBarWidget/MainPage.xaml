<Page
    x:Class="ObsGameBarWidget.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ObsGameBarWidget"
    xmlns:models="using:ObsGameBarWidget.Models"
    xmlns:converters="using:ObsGameBarWidget.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    RequestedTheme="Dark"
    Background="#25272B">

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:SceneBackgroundConverter x:Key="SceneBackgroundConverter"/>
        <converters:MuteBackgroundConverter x:Key="MuteBackgroundConverter"/>
        <converters:MuteIconConverter x:Key="MuteIconConverter"/>
        <converters:MuteTextConverter x:Key="MuteTextConverter"/>

        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- Style "natif" Game Bar : bouton plein, coins arrondis, fine bordure -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#5B5E65"/>
            <Setter Property="Background" Value="#3A3C42"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- Petit bouton carre (icone seule) -->
        <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <!-- Ligne de liste (scenes) -->
        <Style x:Key="ListRowButtonStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#B4B7BD"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- EN-TETE : titre + statut + connexion + parametres -->
        <Grid Grid.Row="0" Padding="16,14,16,10" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="OBS Studio" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse Width="8" Height="8" Fill="{x:Bind StatusBrush, Mode=OneWay}" VerticalAlignment="Center"/>
                    <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </StackPanel>

            <Button Grid.Column="1" Click="OnConnectToggleClicked" Style="{StaticResource ActionButtonStyle}"
                    MinHeight="36" Padding="14,0" FontSize="13" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ConnectButtonText, Mode=OneWay}"/>
            </Button>

            <Button Grid.Column="2" Click="OnSettingsToggleClicked" Style="{StaticResource IconButtonStyle}"
                    Width="36" MinHeight="36" VerticalAlignment="Center">
                <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE713;" FontSize="16"/>
            </Button>
        </Grid>

        <!-- NOTIFICATION -->
        <Border Grid.Row="1" x:Name="NotificationBanner" Visibility="Collapsed" Background="#2E7D4F"
                CornerRadius="6" Margin="16,0,16,8" Padding="12,8">
            <TextBlock x:Name="NotificationText" Text="" FontSize="12" Foreground="White" TextWrapping="Wrap"/>
        </Border>

        <!-- CONTENU -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Padding="16,0,16,16" Spacing="8">

                <!-- DIFFUSER -->
                <Button Click="OnStreamClicked" Style="{StaticResource ActionButtonStyle}" MinHeight="52"
                        Background="{x:Bind StreamBackgroundBrush, Mode=OneWay}">
                    <Grid HorizontalAlignment="Stretch" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE93E;" FontSize="16"
                                  Foreground="{x:Bind StreamIconBrush, Mode=OneWay}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{x:Bind StreamButtonLabel, Mode=OneWay}" HorizontalAlignment="Left"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{x:Bind StreamTimecodeText, Mode=OneWay}"
                                   Style="{StaticResource SecondaryTextStyle}" Foreground="#E6E7EA" VerticalAlignment="Center"/>
                    </Grid>
                </Button>

                <!-- ENREGISTRER -->
                <!-- NB : StackPanel.Spacing compte aussi les enfants Collapsed (UWP) -> on utilise un Margin sur le bouton Pause -->
                <StackPanel>
                    <Button Click="OnRecordClicked" Style="{StaticResource ActionButtonStyle}" MinHeight="52"
                            Background="{x:Bind RecordBackgroundBrush, Mode=OneWay}">
                        <Grid HorizontalAlignment="Stretch" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="12" Height="12" Fill="{x:Bind RecordIconBrush, Mode=OneWay}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{x:Bind RecordButtonLabel, Mode=OneWay}" HorizontalAlignment="Left"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{x:Bind RecordTimecodeText, Mode=OneWay}"
                                       Style="{StaticResource SecondaryTextStyle}" Foreground="#E6E7EA" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <Button Click="OnRecordPauseClicked" Style="{StaticResource ActionButtonStyle}" Margin="0,8,0,0"
                            Visibility="{x:Bind RecordPauseVisibility, Mode=OneWay}">
                        <TextBlock Text="{x:Bind RecordPauseLabel, Mode=OneWay}"/>
                    </Button>
                </StackPanel>

                <!-- CLIP + CAMERA VIRTUELLE -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Click="OnSaveReplayClicked" Style="{StaticResource ActionButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE768;" FontSize="14"/>
                            <TextBlock Text="Sauver clip" FontSize="13"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="1" Click="OnVirtualCamClicked" Style="{StaticResource ActionButtonStyle}"
                            Background="{x:Bind VirtualCamBackgroundBrush, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE714;" FontSize="14"/>
                            <TextBlock Text="{x:Bind VirtualCamButtonLabel, Mode=OneWay}" FontSize="13"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Separateur -->
                <Rectangle Height="1" Fill="#3A3C42" Margin="0,8,0,4"/>

                <!-- SCENES -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Scènes" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Click="OnRefreshScenesClicked" Background="Transparent" BorderThickness="0"
                            Padding="8" CornerRadius="6" Foreground="#B4B7BD">
                        <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE72C;" FontSize="14"/>
                    </Button>
                </Grid>

                <Grid>
                <TextBlock Text="Connectez-vous à OBS pour afficher les scènes et les sources audio."
                           Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"
                           Visibility="{x:Bind DisconnectedHintVisibility, Mode=OneWay}"/>

                <ItemsControl ItemsSource="{x:Bind ScenesList}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:ObsSceneItem">
                            <Button Click="OnSceneItemClicked" Style="{StaticResource ListRowButtonStyle}"
                                    Background="{x:Bind IsCurrent, Converter={StaticResource SceneBackgroundConverter}, Mode=OneWay}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE8B9;" FontSize="16"
                                              Foreground="#B4B7BD" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <FontIcon Grid.Column="2" FontFamily="{StaticResource IconFont}" Glyph="&#xE73E;" FontSize="14"
                                              Foreground="#4CC2FF" VerticalAlignment="Center"
                                              Visibility="{x:Bind IsCurrent, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </Grid>

                <!-- Separateur -->
                <Rectangle Height="1" Fill="#3A3C42" Margin="0,8,0,4"/>

                <!-- AUDIO -->
                <TextBlock Text="Audio" Style="{StaticResource SectionTitleStyle}"/>

                <ItemsControl ItemsSource="{x:Bind AudioInputsList}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:ObsAudioInput">
                            <Grid ColumnSpacing="12" Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Click="OnAudioMuteClicked" Style="{StaticResource IconButtonStyle}"
                                        Background="{x:Bind IsMuted, Converter={StaticResource MuteBackgroundConverter}, Mode=OneWay}">
                                    <FontIcon FontFamily="{StaticResource IconFont}" FontSize="16"
                                              Glyph="{x:Bind IsMuted, Converter={StaticResource MuteIconConverter}, Mode=OneWay}"/>
                                </Button>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}" FontSize="14" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind IsMuted, Converter={StaticResource MuteTextConverter}, Mode=OneWay}"
                                               Style="{StaticResource SecondaryTextStyle}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

        <!-- PARAMETRES (overlay) -->
        <Border Grid.Row="0" Grid.RowSpan="3" x:Name="SettingsOverlay" Visibility="Collapsed" Background="#25272B">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="16,14,16,16" Spacing="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Paramètres" FontSize="18" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Click="OnSettingsCloseClicked" Style="{StaticResource IconButtonStyle}"
                                Width="36" MinHeight="36">
                            <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE711;" FontSize="14"/>
                        </Button>
                    </Grid>

                    <TextBlock Text="Accès au serveur OBS WebSocket (OBS Studio > Outils > Paramètres du serveur WebSocket)."
                               Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"/>

                    <TextBox x:Name="HostInput" Header="Hôte / IP" PlaceholderText="127.0.0.1"/>
                    <TextBox x:Name="PortInput" Header="Port" PlaceholderText="4455" InputScope="Number"/>
                    <PasswordBox x:Name="PasswordInput" Header="Mot de passe WebSocket" PlaceholderText="Optionnel"/>

                    <CheckBox x:Name="AutoConnectCheck" Content="Connexion automatique à l'ouverture"/>

                    <Button Click="OnSaveSettingsClicked" Style="{StaticResource ActionButtonStyle}"
                            Background="#0078D4" BorderBrush="#2B8CE0" FontWeight="SemiBold" Margin="0,6,0,0">
                        <TextBlock Text="Enregistrer et connecter"/>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>

    </Grid>
</Page>
