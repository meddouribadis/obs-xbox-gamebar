<Page
    x:Class="ObsGameBarWidget.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ObsGameBarWidget"
    xmlns:models="using:ObsGameBarWidget.Models"
    xmlns:converters="using:ObsGameBarWidget.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#17191E">

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:SceneBackgroundConverter x:Key="SceneBackgroundConverter"/>
        <converters:MuteBackgroundConverter x:Key="MuteBackgroundConverter"/>
        <converters:MuteIconConverter x:Key="MuteIconConverter"/>
        <converters:MuteTextConverter x:Key="MuteTextConverter"/>

        <!-- Styles pour boutons de contrôle -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Height" Value="54"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="Background" Value="#252830"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="3"/>
        </Style>

        <Style x:Key="SceneButtonStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#22FFFFFF"/>
            <Setter Property="Background" Value="#2A2D36"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="2,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>
    </Page.Resources>

    <Grid Background="#17191E">
        <Grid.RowDefinitions>
            <!-- En-tête / Barre de statut -->
            <RowDefinition Height="Auto"/>
            <!-- Notification toast -->
            <RowDefinition Height="Auto"/>
            <!-- Contenu principal -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- EN-TETE -->
        <Border Grid.Row="0" Background="#20232B" Padding="12,10" BorderBrush="#2F333D" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Titre -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Fill="{x:Bind StatusBrush, Mode=OneWay}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="OBS Studio" FontWeight="Bold" FontSize="14" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Statut de connexion -->
                <TextBlock Grid.Column="1" Text="{x:Bind StatusText, Mode=OneWay}"
                           FontSize="11" Foreground="#A0A5B5" VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis"/>

                <!-- Bouton Reconnecter / Déconnecter -->
                <Button Grid.Column="2" Click="OnConnectToggleClicked" Margin="0,0,6,0" Padding="8,4" CornerRadius="4"
                        Background="#2D313B" BorderBrush="#3D4250" BorderThickness="1">
                    <TextBlock Text="{x:Bind ConnectButtonText, Mode=OneWay}" FontSize="11" Foreground="White"/>
                </Button>

                <!-- Bouton Paramètres (Engrenage) -->
                <Button Grid.Column="3" Click="OnSettingsToggleClicked" Padding="8,4" CornerRadius="4"
                        Background="#2D313B" BorderBrush="#3D4250" BorderThickness="1">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" FontSize="13" Foreground="White"/>
                </Button>
            </Grid>
        </Border>

        <!-- BANNIERE DE NOTIFICATION -->
        <Border Grid.Row="1" x:Name="NotificationBanner" Visibility="Collapsed" Background="#0E7036" Padding="10,6">
            <TextBlock x:Name="NotificationText" Text="Clip sauvegardé avec succès !" FontSize="11" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"/>
        </Border>

        <!-- CONTENU PRINCIPAL SCROLLABLE -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Padding="10" Spacing="10">

                <!-- SECTION 1 : ACTIONS RAPIDES (ENREGISTREMENT & STREAM) -->
                <TextBlock Text="ACTIONS EN DIRECT" FontSize="11" FontWeight="Bold" Foreground="#888E9E" Margin="2,4,0,0"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- BOUTON ENREGISTRER (REC) -->
                    <Border Grid.Column="0" Margin="3" CornerRadius="6" Background="{x:Bind RecordBackgroundBrush, Mode=OneWay}"
                            BorderBrush="#44FFFFFF" BorderThickness="1">
                        <Grid Padding="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Button Click="OnRecordClicked" Style="{StaticResource ActionButtonStyle}" Background="Transparent" BorderThickness="0" Margin="0" Height="44">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Ellipse Width="12" Height="12" Fill="{x:Bind RecordIconBrush, Mode=OneWay}" Margin="0,0,6,0"/>
                                    <TextBlock Text="{x:Bind RecordButtonLabel, Mode=OneWay}" FontWeight="Bold" FontSize="13"/>
                                </StackPanel>
                            </Button>

                            <TextBlock Grid.Row="1" Text="{x:Bind RecordTimecodeText, Mode=OneWay}"
                                       FontSize="11" Foreground="#C0C5D0" HorizontalAlignment="Center" Margin="0,2,0,0"/>

                            <!-- Bouton Pause Enregistrement -->
                            <Button Grid.Row="2" Click="OnRecordPauseClicked" Visibility="{x:Bind RecordPauseVisibility, Mode=OneWay}"
                                    HorizontalAlignment="Center" Margin="0,4,0,0" Padding="6,2" CornerRadius="3"
                                    Background="#33000000" BorderThickness="0">
                                <TextBlock Text="{x:Bind RecordPauseLabel, Mode=OneWay}" FontSize="10" Foreground="#E0E0E0"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- BOUTON STREAM (DIFFUSER) -->
                    <Border Grid.Column="1" Margin="3" CornerRadius="6" Background="{x:Bind StreamBackgroundBrush, Mode=OneWay}"
                            BorderBrush="#44FFFFFF" BorderThickness="1">
                        <Grid Padding="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Button Click="OnStreamClicked" Style="{StaticResource ActionButtonStyle}" Background="Transparent" BorderThickness="0" Margin="0" Height="44">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE93E;" FontSize="14" Foreground="{x:Bind StreamIconBrush, Mode=OneWay}" Margin="0,0,6,0"/>
                                    <TextBlock Text="{x:Bind StreamButtonLabel, Mode=OneWay}" FontWeight="Bold" FontSize="13"/>
                                </StackPanel>
                            </Button>

                            <TextBlock Grid.Row="1" Text="{x:Bind StreamTimecodeText, Mode=OneWay}"
                                       FontSize="11" Foreground="#C0C5D0" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- SECTION 2 : REPLAY BUFFER & CAMERA VIRTUELLE -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Sauvegarder Clip / Replay Buffer -->
                    <Button Grid.Column="0" Click="OnSaveReplayClicked" Style="{StaticResource ActionButtonStyle}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE768;" FontSize="14" Foreground="#FFD700" Margin="0,0,6,0"/>
                            <TextBlock Text="Sauver Clip" FontWeight="SemiBold" FontSize="12"/>
                        </StackPanel>
                    </Button>

                    <!-- Caméra Virtuelle -->
                    <Button Grid.Column="1" Click="OnVirtualCamClicked" Style="{StaticResource ActionButtonStyle}"
                            Background="{x:Bind VirtualCamBackgroundBrush, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE714;" FontSize="14" Margin="0,0,6,0"/>
                            <TextBlock Text="{x:Bind VirtualCamButtonLabel, Mode=OneWay}" FontWeight="SemiBold" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- SECTION 3 : SCENES -->
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="SCÈNES" FontSize="11" FontWeight="Bold" Foreground="#888E9E" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Click="OnRefreshScenesClicked" Padding="6,2" CornerRadius="3" Background="Transparent" BorderThickness="0">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" FontSize="11" Foreground="#888E9E"/>
                    </Button>
                </Grid>

                <ItemsControl ItemsSource="{x:Bind ScenesList}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:ObsSceneItem">
                            <Button Click="OnSceneItemClicked" Style="{StaticResource SceneButtonStyle}"
                                    Background="{x:Bind IsCurrent, Converter={StaticResource SceneBackgroundConverter}, Mode=OneWay}">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Name}" FontSize="12"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <Ellipse Grid.Column="1" Width="8" Height="8" Fill="#00D26A"
                                             Visibility="{x:Bind IsCurrent, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}"
                                             VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- SECTION 4 : MIXEUR AUDIO RAPIDE -->
                <TextBlock Text="AUDIO / MUTE RAPIDE" FontSize="11" FontWeight="Bold" Foreground="#888E9E" Margin="2,8,0,0"/>

                <ItemsControl ItemsSource="{x:Bind AudioInputsList}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:ObsAudioInput">
                            <Border Margin="0,2" Padding="8,6" CornerRadius="4" Background="#242730" BorderBrush="#2D303C" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Name}" FontSize="12" Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <Button Grid.Column="1" Click="OnAudioMuteClicked" Padding="8,4" CornerRadius="4"
                                            Background="{x:Bind IsMuted, Converter={StaticResource MuteBackgroundConverter}, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                                       Text="{x:Bind IsMuted, Converter={StaticResource MuteIconConverter}, Mode=OneWay}"
                                                       FontSize="12" Foreground="White" Margin="0,0,4,0"/>
                                            <TextBlock Text="{x:Bind IsMuted, Converter={StaticResource MuteTextConverter}, Mode=OneWay}"
                                                       FontSize="11" Foreground="White"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

        <!-- VOLET PARAMETRES (OVERLAY) -->
        <Border Grid.Row="0" Grid.RowSpan="3" x:Name="SettingsOverlay" Visibility="Collapsed"
                Background="#EE17191E" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Paramètres OBS WebSocket" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Click="OnSettingsCloseClicked" Background="Transparent" BorderThickness="0" Padding="6">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE711;" FontSize="13" Foreground="White"/>
                        </Button>
                    </Grid>

                    <TextBlock Text="Configurez les accès au serveur OBS WebSocket (OBS Studio > Outils > Paramètres du serveur WebSocket)."
                               FontSize="11" Foreground="#A0A5B5" TextWrapping="Wrap"/>

                    <!-- Hôte / IP -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Hôte / IP (défaut : 127.0.0.1)" FontSize="11" Foreground="#CCD0DC"/>
                        <TextBox x:Name="HostInput" PlaceholderText="127.0.0.1" Background="#262933" Foreground="White" BorderBrush="#3E4352"/>
                    </StackPanel>

                    <!-- Port -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Port (défaut : 4455)" FontSize="11" Foreground="#CCD0DC"/>
                        <TextBox x:Name="PortInput" PlaceholderText="4455" InputScope="Number" Background="#262933" Foreground="White" BorderBrush="#3E4352"/>
                    </StackPanel>

                    <!-- Mot de passe -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Mot de passe WebSocket" FontSize="11" Foreground="#CCD0DC"/>
                        <PasswordBox x:Name="PasswordInput" PlaceholderText="Optionnel si sans mot de passe" Background="#262933" Foreground="White" BorderBrush="#3E4352"/>
                    </StackPanel>

                    <!-- Connexion automatique -->
                    <CheckBox x:Name="AutoConnectCheck" Content="Connexion automatique à l'ouverture" Foreground="White" FontSize="12"/>

                    <!-- Bouton Sauvegarder & Reconnecter -->
                    <Button Click="OnSaveSettingsClicked" HorizontalAlignment="Stretch" Height="40"
                            Background="#0078D7" Foreground="White" FontWeight="Bold" CornerRadius="4" Margin="0,10,0,0">
                        <TextBlock Text="Enregistrer et Connecter"/>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>

    </Grid>
</Page>
